{
  "expo": {
    "name": "Oria",
    "slug": "lbv-connectia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/oria-logo.png",
    "scheme": "oria",
    "userInterfaceStyle": "automatic",

    "ios": {
      "bundleIdentifier": "com.lbvconnect.oria",
      "icon": "./assets/images/oria-logo.png"
    },

    "android": {
      "package": "com.lbvconnect.oria",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/oria-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/oria-logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-sharing"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "1832348e-2837-4236-ae2d-2edbd47f2824"
      }
    },

    "owner": "lbv-connect"
  }
}
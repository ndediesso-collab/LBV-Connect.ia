{
  "title": "Simulation des coûts API d'ORIA",
  "kind": "calculator",
  "description": "Modifiez chaque paramètre : les résultats se recalculent immédiatement.",
  "inputs": [
    {"id":"users","label":"Utilisateurs actifs par jour","control":"slider","min":0,"max":2000,"step":20,"value":360,"unit":""},
    {"id":"requests","label":"Requêtes par utilisateur","control":"slider","min":1,"max":30,"step":1,"value":10,"unit":""},
    {"id":"cost","label":"Coût moyen par requête","control":"number","min":0,"max":100,"step":0.5,"value":5,"unit":"FCFA"}
  ],
  "outputs": [
    {"id":"daily","label":"Coût API / jour","expr":{"op":"mul","args":["users","requests","cost"]},"unit":"FCFA","precision":0},
    {"id":"monthly","label":"Projection sur 30 jours","expr":{"op":"mul","args":["daily",30]},"unit":"FCFA","precision":0}
  ],
  "assumptions": "Hypothèses fictives. Adapter le coût unitaire aux tarifs réels et à l'usage de chaque modèle."
}
